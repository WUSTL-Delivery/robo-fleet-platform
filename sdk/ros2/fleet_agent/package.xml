<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_agent</name>
  <version>0.0.1</version>
  <description>
    Bridges a ROS 2 robot onto fleet-server: declares the capability manifest, publishes
    operator twist onto a twist_mux input, reports pose/battery/health as telemetry, and
    raises the robot's hand for the intervention queue.
  </description>
  <maintainer email="j.rodriguezgomez@wustl.edu">Jonathan Rodriguez-Gomez</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <!--
    The Python SDK (`fleet`) is not on PyPI yet, so rosdep cannot resolve it. Install it
    into the same interpreter the node runs under: `pip install -e sdk/python`.

    Deliberately absent until the inputs they serve exist on the robot (see the
    "not wired yet" methods in agent_node.py): nav_msgs for Odometry, action_msgs for
    cancelling Nav2 goals on takeover.
  -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
