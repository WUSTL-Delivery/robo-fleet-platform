# Copy to .env (git-ignored) and fill in. run_fake_robot.sh loads it.

# Where the robot connects. Local server: ws://localhost:8080/ws
FLEET_URL=wss://fleet.bearcarts.com/ws

# The fleet's enrollment key. Needed on the first run only; after that the robot uses
# the token saved in ~/.fleet/<name>.json. Treat it like a password.
FLEET_ENROLL_KEY=

# macOS python.org Python ships without CA certificates, so wss:// fails with
# "unable to get local issuer certificate". This points it at the system bundle.
SSL_CERT_FILE=/etc/ssl/cert.pem

# Optional
FLEET_NAME=fake-robot-01
# FAKE_ORIGIN=38.6488,-90.3108   # lat,lon it wanders around (default: WashU)
# FAKE_RADIUS_M=80
# FAKE_SPEED_MPS=0.8
# FAKE_TELEMETRY_HZ=2
# FAKE_HELP_AFTER_S=0            # ask for help after N seconds; 0 = never
# FLEET_ICE_SERVERS='[{"urls": "stun:stun.example.org:3478"}]'   # STUN/TURN for the WebRTC data channel; default none
