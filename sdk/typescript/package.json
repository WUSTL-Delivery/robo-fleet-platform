{
  "name": "@fleet-platform/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK for fleet-platform: protocol types generated from protocol/schemas, plus the connection client.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "gen:check": "tsx scripts/gen.ts --check",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
