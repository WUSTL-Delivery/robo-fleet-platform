{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetplatform.local/v0/ops.schema.json",
  "title": "Subscriptions, events, intervention queue, leases",
  "$defs": {
    "subscribe": {
      "type": "object",
      "properties": {
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,79}$" }
        }
      },
      "required": ["topics"],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "robots": {
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/robotSummary" }
        },
        "operators": {
          "description": "Every operator of the fleet that is not revoked, online or not. The server always sends it.",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/operatorSummary" }
        }
      },
      "required": ["robots"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event": { "$ref": "defs.schema.json#/$defs/eventName" },
        "robot_id": { "description": "The robot the event is about. Set on every robot.* event, absent otherwise.", "type": "string" },
        "operator_id": { "description": "The operator the event is about. Set on every operator.* event, absent otherwise.", "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "lease.claim": {
      "type": "object",
      "properties": {
        "robot_id": { "type": "string", "minLength": 1 },
        "steal": {
          "description": "True to take the robot from another operator who holds its lease (revoke + reissue). Absent or false, a claim on a robot leased to another operator is refused with error{code: conflict}.",
          "type": "boolean"
        }
      },
      "required": ["robot_id"],
      "additionalProperties": false
    },
    "lease.granted": { "$ref": "defs.schema.json#/$defs/lease" },
    "lease.renew": {
      "type": "object",
      "properties": {
        "lease_id": { "type": "string", "minLength": 1 }
      },
      "required": ["lease_id"],
      "additionalProperties": false
    },
    "lease.release": {
      "type": "object",
      "properties": {
        "lease_id": { "type": "string", "minLength": 1 },
        "resolution": { "enum": ["resolved", "abandoned"] }
      },
      "required": ["lease_id", "resolution"],
      "additionalProperties": false
    },
    "lease.revoked": {
      "type": "object",
      "properties": {
        "lease_id": { "type": "string", "minLength": 1 },
        "robot_id": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["released", "expired", "stolen", "operator_lost"] },
        "help": { "$ref": "defs.schema.json#/$defs/helpDetails" }
      },
      "required": ["lease_id", "robot_id", "reason"],
      "additionalProperties": false
    },
    "watch": {
      "description": "Operator to server: which robot this operator is looking at. It lasts as long as the connection that sent it.",
      "type": "object",
      "properties": {
        "robot_id": {
          "description": "A robot of the operator's fleet, or null to stop watching.",
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": ["robot_id"],
      "additionalProperties": false
    }
  }
}
