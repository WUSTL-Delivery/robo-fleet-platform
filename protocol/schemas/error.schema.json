{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetplatform.local/v0/error.schema.json",
  "title": "Server error reply",
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "auth_failed",
            "invalid_message",
            "not_found",
            "not_authorized",
            "conflict",
            "rate_limited"
          ]
        },
        "message": { "type": "string", "maxLength": 512 },
        "ref": { "type": "string", "maxLength": 64 },
        "lease": {
          "description": "Set only on the conflict that refuses a lease.claim: the lease that is in the way, as held at the moment of the refusal.",
          "$ref": "defs.schema.json#/$defs/lease"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
